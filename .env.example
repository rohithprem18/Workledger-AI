# WorkLedger AI — environment template
#
# Copy to `.env` for docker-compose, or set these as environment variables on
# your hosting platform. `.env` is gitignored; never commit real secrets.
#
# Only the database and JWT settings are required. Everything else has a working
# default, and the platform is fully functional with the AI and email keys left
# blank — every AI-assisted feature has a deterministic engine behind it.

# ============================================================================
# DATABASE  (required)
# ============================================================================
# Either supply the parts…
DB_URL=jdbc:postgresql://localhost:5432/workledger
DB_USERNAME=postgres
DB_PASSWORD=postgres

# …or let the platform supply one URL. Render, Railway, Heroku and Fly inject
# this automatically; the app converts it to JDBC at startup. When DB_URL above
# is set, it wins.
# DATABASE_URL=postgres://user:password@host:5432/workledger

# ============================================================================
# SECURITY  (required)
# ============================================================================
# Minimum 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=ChangeMeInProductionThisMustBeAtLeast32CharactersLong

# Comma-separated origins allowed to call the API. Never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Failed logins allowed per minute, per IP.
LOGIN_RATE_LIMIT=20

# ============================================================================
# GENERATIVE AI  (optional — leave disabled to run at zero cost)
# ============================================================================
# With AI_ENABLED=false the platform still extracts contract attributes (by
# pattern matching) and still audits invoices (the auditor is deterministic by
# design). Turning it on adds recall on unusual contract wording, and
# plain-English explanations of audit findings.
#
# Any OpenAI-compatible endpoint works. Free options, all with a generous tier:
#
#   Groq      AI_BASE_URL=https://api.groq.com/openai
#             AI_MODEL=llama-3.3-70b-versatile
#             key: https://console.groq.com/keys
#
#   Gemini    AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#             AI_MODEL=gemini-2.0-flash
#             key: https://aistudio.google.com/apikey
#
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api
#               AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#               key: https://openrouter.ai/keys
#
#   Ollama    AI_BASE_URL=http://localhost:11434    (local, no key at all)
#             AI_MODEL=llama3.1
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=llama-3.3-70b-versatile
AI_ENGINE_LABEL=groq/llama-3.3-70b

# ============================================================================
# EMAIL  (optional — invoice delivery is skipped when unset)
# ============================================================================
# Free tier: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@workledger.example

# ============================================================================
# RUNTIME
# ============================================================================
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
# PORT is injected by most hosts; set it only to override the default 8080.
# PORT=8080

# ============================================================================
# FRONTEND  (build-time — Vite inlines this into the bundle)
# ============================================================================
# Leave unset for same-origin deploys (docker-compose, the Vite dev proxy).
# Set it when the frontend and API are on different hosts, e.g.
# VITE_API_BASE_URL=https://workledger-api.onrender.com/api

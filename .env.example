# WorkLedger AI — environment template
#
# Copy to `.env` for local development, or set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for a deployment.
# `.env` is gitignored; never commit real secrets.
#
# Only DATABASE_URL and JWT_SECRET are required. Everything else has a working
# default, and the platform is fully functional with the AI key left blank —
# every AI-assisted feature has a deterministic engine behind it.

# ============================================================================
# DATABASE  (required)
# ============================================================================
# Any PostgreSQL 15+ instance. Neon's free tier is the intended pairing, and is
# what Vercel provisions from its Storage tab:
#   https://neon.tech  →  Project → Connection string
#
# Must include ?sslmode=require for a managed provider.
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/workledger?sslmode=require

# Vercel's Neon integration injects POSTGRES_URL automatically; it is read as a
# fallback, so on Vercel you often do not need to set DATABASE_URL at all.
# POSTGRES_URL=

# ============================================================================
# SECURITY  (required)
# ============================================================================
# Minimum 32 characters. Generate one with:  openssl rand -base64 48
# The API refuses to sign tokens with anything shorter.
JWT_SECRET=ChangeMeInProductionThisMustBeAtLeast32CharactersLong

# Only needed when the frontend is served from a different origin than the API.
# On Vercel they share a domain, so this can stay empty.
CORS_ALLOWED_ORIGINS=

# Sign-in attempts allowed per minute, per username+IP.
LOGIN_RATE_LIMIT=20

# ============================================================================
# GENERATIVE AI  (optional — leave disabled to run at zero cost)
# ============================================================================
# With AI_ENABLED=false the platform still extracts contract attributes (by
# pattern matching) and still audits invoices (the auditor is deterministic by
# design). Turning it on adds recall on unusual contract wording, and
# plain-English explanations of audit findings.
#
# Any OpenAI-compatible endpoint works. Free options, all with a usable tier:
#
#   Groq        AI_BASE_URL=https://api.groq.com/openai
#               AI_MODEL=openai/gpt-oss-120b
#               key: https://console.groq.com/keys
#
#   Gemini      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#               AI_MODEL=gemini-2.0-flash
#               key: https://aistudio.google.com/apikey
#
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api
#               AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#               key: https://openrouter.ai/keys
#
#   Ollama      AI_BASE_URL=http://localhost:11434    (local, no key at all)
#               AI_MODEL=llama3.1
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=openai/gpt-oss-120b
AI_ENGINE_LABEL=groq/gpt-oss-120b

# Contract text beyond this many characters is truncated before prompting.
AI_MAX_SOURCE_CHARS=24000
# Give up on a model call after this long and fall back to the pattern engine.
AI_TIMEOUT_MS=45000

# ============================================================================
# LOCAL DEVELOPMENT
# ============================================================================
# Port for `npm run dev` (the API). Vite proxies /api here from port 5173.
# Vercel assigns its own port in production and ignores this.
PORT=8080

# ============================================================================
# FRONTEND  (build-time — Vite inlines this into the bundle)
# ============================================================================
# Leave unset for the normal deployment, where the SPA and API share an origin
# and the client defaults to a relative /api. Only set it when the frontend is
# hosted somewhere other than the API:
# VITE_API_BASE_URL=https://your-api.vercel.app/api

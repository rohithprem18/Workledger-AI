{
  "name": "workledger-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Contingent workforce intelligence platform — Node API + React, deployed on Vercel",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/dev.ts",
    "build": "npm --prefix Frontend install && npm --prefix Frontend run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx server/db/migrate.ts",
    "smoke": "node scripts/smoke.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "ui:check": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "pg": "^8.23.0",
    "unpdf": "^1.3.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.23.1",
    "playwright": "^1.63.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
